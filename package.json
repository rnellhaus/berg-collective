    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.3.2",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "google-auth-library": "^10.9.0",
