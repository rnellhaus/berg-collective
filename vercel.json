{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "blackergcollective.com" }],
      "destination": "https://bergcollective.org/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.blackergcollective.com" }],
      "destination": "https://bergcollective.org/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.bergcollective.org" }],
      "destination": "https://bergcollective.org/$1",
      "permanent": true
    },
    { "source": "/join", "destination": "/membership", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
